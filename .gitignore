# ========================
# 环境变量 (包含敏感信息)
# ========================
.env

# ========================
# Python 编译产物
# ========================
__pycache__/
*.pyc
*.pyo
*.pyd

# ========================
# IDE 配置
# ========================
.idea/
# .vscode：个人设置不入库，但共享推荐插件列表（协作者开箱即用）
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# ========================
# 运行时数据
# ========================
output/
updated/
# Agent 会话历史数据库（运行时生成），演示数据脚本 seed_demo.sql 保留入库
#
# 注意：必须写成 data/*.db*  而不是 data/*.db
#   SQLite 的 -wal / -shm 与主库同源，-wal 里是尚未 checkpoint 的
#   明文会话数据页（对话内容、生成的报告、执行过的 SQL 及结果）。
#   写成 *.db 只会匹配以 .db 结尾的文件，-wal / -shm 会漏网并被提交。
data/*.db*
logs/
*.log

# ========================
# 私有笔记（含求职/面试备战等非公开内容，不进仓库）
# ========================
private-notes/

# ========================
# 虚拟环境
# ========================
.venv/
venv/
env/
# 本机解释器覆盖文件（start_api.bat 读取，每台机器路径不同，不进仓库）
.dsp-python.txt

# ========================
# Claude Code
# ========================
.claude/

# 测试临时文件
# ========================
tools/test_session_*/
.pytest_cache/
.ruff_cache/

# ========================
# 操作系统
# ========================
.DS_Store
Thumbs.db

# ========================
# 本地临时 / 备份目录
# ========================
_backup_*/
_backup-*/
*.bak
