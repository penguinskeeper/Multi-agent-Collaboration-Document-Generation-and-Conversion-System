# ============================================================
# Deep Search Pro - 环境变量模板
#
# 用法：复制本文件为 .env，再填入你自己的值
#     Windows :  copy .env.example .env
#     Linux/mac: cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会进入仓库——请勿把真实密钥写进本文件。
#
# 最小可跑配置：只填 LLM 与 Tavily 两组即可。
# 未配置的组会按设计「优雅降级」：
#   - 不配 MySQL   → 跳过数据库子智能体
#   - 不配 RAGFlow → 跳过知识库子智能体
#   - API_KEY 留空 → 进入开发模式，接口不做鉴权
# ============================================================


# ---------- 必填：LLM（任何 OpenAI 兼容接口均可） ----------
# OPENAI_BASE_URL / OPENAI_API_KEY 由 langchain-openai 直接读取，不要改名
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
# 模型名，需与上面的服务商匹配（如 qwen-max / gpt-4o-mini / deepseek-chat）
LLM=qwen-max


# ---------- 必填：Tavily 联网搜索 ----------
# 免费额度申请：https://tavily.com
TAVILY_API_KEY=


# ---------- 可选：MySQL（数据库子智能体） ----------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dsp_reader
MYSQL_PASSWORD=
# 本机手工部署（db_setup/）与 Docker 一键路线（data/seed_demo.sql）建库名不同，
# 请按你实际导入的那套填写：pharma_mall 或 pharma_demo
MYSQL_DATABASE=pharma_demo
# 仅 docker compose 使用，本机直接运行不需要
MYSQL_ROOT_PASSWORD=

# 以下三项有默认值，通常无需修改
# MYSQL_CHARSET=utf8mb4
# MYSQL_COLLATION=utf8mb4_unicode_ci
# MYSQL_SQL_MODE=TRADITIONAL


# ---------- 可选：RAGFlow 知识库（知识库子智能体） ----------
RAGFLOW_API_URL=
RAGFLOW_API_KEY=


# ---------- 可选：接口安全 ----------
# 留空 = 开发模式，接口不校验；填了则写接口需带 X-API-Key 请求头
API_KEY=
# CORS 白名单，逗号分隔；部署到域名后记得改成你的实际来源
API_ALLOWED_ORIGINS=http://localhost:8000
